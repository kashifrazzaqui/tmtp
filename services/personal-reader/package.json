{
  "name": "@tmtp/personal-reader",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "personal-reader": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/service.d.ts",
      "import": "./dist/service.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && vite build",
    "test": "vitest run",
    "test:ui": "playwright test --config test/ui/playwright.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/cli.js start",
    "doctor": "node dist/cli.js doctor"
  },
  "dependencies": {
    "@emotion/react": "catalog:",
    "@emotion/styled": "catalog:",
    "@fastify/cookie": "catalog:",
    "@fastify/static": "catalog:",
    "@mui/material": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@tmtp/access-control": "workspace:*",
    "@tmtp/activity": "workspace:*",
    "@tmtp/article-extractor": "workspace:*",
    "@tmtp/article-fetcher": "workspace:*",
    "@tmtp/article-reader": "workspace:*",
    "@tmtp/clock": "workspace:*",
    "@tmtp/config": "workspace:*",
    "@tmtp/database": "workspace:*",
    "@tmtp/diagnostics": "workspace:*",
    "@tmtp/domain": "workspace:*",
    "@tmtp/hn-account": "workspace:*",
    "@tmtp/hn-ingestion": "workspace:*",
    "@tmtp/hn-public-api": "workspace:*",
    "@tmtp/http-client": "workspace:*",
    "@tmtp/interests": "workspace:*",
    "@tmtp/job-queue": "workspace:*",
    "@tmtp/llm-interface": "workspace:*",
    "@tmtp/llm-openai-compatible": "workspace:*",
    "@tmtp/logging": "workspace:*",
    "@tmtp/personalization": "workspace:*",
    "@tmtp/queue": "workspace:*",
    "@tmtp/reader-app": "workspace:*",
    "@tmtp/reader-store": "workspace:*",
    "@tmtp/recommendations": "workspace:*",
    "@tmtp/retry": "workspace:*",
    "@tmtp/scheduler": "workspace:*",
    "fastify": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router": "catalog:"
